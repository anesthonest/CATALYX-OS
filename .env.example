# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PESAPAL_CONSUMER_KEY: Official Pesapal API v3 Consumer Key for subscription billing.
PESAPAL_CONSUMER_KEY=""

# PESAPAL_CONSUMER_SECRET: Official Pesapal API v3 Consumer Secret.
PESAPAL_CONSUMER_SECRET=""

# PESAPAL_ENVIRONMENT: 'sandbox' for test mode or 'live' for production billing.
PESAPAL_ENVIRONMENT="sandbox"

# PESAPAL_IPN_ID: Registered IPN notification ID for webhook callbacks.
PESAPAL_IPN_ID=""

# NOTE: CATALYX monetization strictly supports PESAPAL v3 and DIRECT BANK TRANSFER only.
# Stripe, PayPal, Flutterwave, and cryptocurrency rails are permanently deactivated.

# TRANSACTIONAL EMAIL DELIVERY (Optional SMTP / SendGrid / Postmark for live network email delivery)
# If unconfigured, CATALYX operates high-security internal dispatch relay with delivery logs & preview mode
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CATALYX Security <security@catalyx.io>"

# GOOGLE IDENTITY SERVICES (Optional OAuth 2.0 Client ID for 1-click Google Sign-In & Account Linking)
# When set, Google GIS SDK automatically renders instant identity authorization
VITE_GOOGLE_CLIENT_ID=""

# MICROSOFT 365 & ONEDRIVE OAUTH 2.0 (Azure App Registration)
# Server-authoritative feature flag: set to 'false' (or omit) to keep integration dormant until Azure credentials exist
MICROSOFT_INTEGRATION_ENABLED="false"
# Server-side only: never expose MICROSOFT_CLIENT_SECRET to client or git
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

